# Canvas Tutor mail configuration
#
# Copy this file to `.env`, fill in one provider, then restart:
# node server.js

# Option A: SMTP
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# EMAIL_FROM="Canvas Tutor <your_email@gmail.com>"

# Outlook example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@outlook.com
# SMTP_PASS=your_password_or_app_password
# EMAIL_FROM="Canvas Tutor <your_email@outlook.com>"

# Option B: Resend (recommended)
# RESEND_API_KEY=re_your_key
# EMAIL_FROM="Canvas Tutor <you@your_verified_domain.com>"
