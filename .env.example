# Canvas Tutor configuration (keep actual secrets in the ignored .env)
#
# Copy this file to `.env`, fill in one provider, then restart:
# npm run preview  # email stays disabled for development

# Option A: SMTP
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# EMAIL_FROM="Canvas Tutor <your_email@gmail.com>"

# Outlook example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@outlook.com
# SMTP_PASS=your_password_or_app_password
# EMAIL_FROM="Canvas Tutor <your_email@outlook.com>"

# Option B: Resend (recommended)
# RESEND_API_KEY=re_your_key
# EMAIL_FROM="Canvas Tutor <you@your_verified_domain.com>"

# AI features (Phases 1–5): indexing, counted/typed practice, guides, chat, grading.
# The key stays on the server. Without it, saved practice and source reading work.
# The Settings/AI Tutor status reports configuration, not provider authorization.
# OPENAI_API_KEY=your_private_openai_key
# OPENAI_MODEL=gpt-5-mini
# One server model is used; OPENAI_MODELS / a model picker are not implemented.

# Local preview. npm run preview enforces EMAIL_DISABLED=1 and HOST=127.0.0.1.
# Normal npm start enables the existing mail scheduler unless EMAIL_DISABLED=1.
# EMAIL_DISABLED=1
# HOST=127.0.0.1
# PORT=4177

# Optional Office and OCR tools (Phase 6). Paths point to executables, not folders.
# LibreOffice: PPT/ODP→PPTX, DOC/RTF/ODT→DOCX, XLS/ODS→XLSX; slide rendering for OCR.
# LIBREOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# CATPPT_PATH=/path/to/catppt
# PDFTOPPM_PATH=/path/to/pdftoppm
# TESSERACT_PATH=/path/to/tesseract
# OCR_LANG=eng
# Language data must be installed in Tesseract (e.g. eng+spa).

# Extraction safety limits (Phases 2 and 6). Positive integers; restart after edits.
# Limits are disclosed in Sources and reading details, never silently applied.
# READER_PDF_PAGES=2000
# READER_PDF_CHARS=2000000
# READER_OFFICE_CHARS=2000000
# READER_NOTEBOOK_CELLS=20000
# READER_NOTEBOOK_CHARS=2000000
# READER_TEXT_CHARS=2000000
# READER_CODE_CHARS=2000000
# READER_HTML_CHARS=2000000
# READER_OCR_CHARS=2000000
# READER_LEGACY_PPT_CHARS=2000000
# READER_ZIP_FILES=1000
# READER_ZIP_FILE_CHARS=2000000
# READER_ZIP_TOTAL_CHARS=10000000
# READER_ZIP_ENTRIES=10000
# READER_ZIP_ENTRY_BYTES=32000000
# READER_ZIP_TOTAL_BYTES=128000000
# READER_OCR_PAGES=30
# READER_OCR_PAGE_TIMEOUT_MS=20000
# READER_OCR_TIMEOUT_MS=120000

# Student preferences (count, difficulty, types), saved sets and review progress
# are browser-local study data, not server settings. Canvas tokens stay in memory.
# Full/Quick indexing, batch sizes, retry counts and AI deadlines are code-defined;
# extraction limits do not change how much text is sent in each AI request.
